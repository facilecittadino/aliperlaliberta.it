aliperlaliberta.it, www.aliperlaliberta.it {
  root * /var/www/aliperlaliberta.it
  encode zstd gzip

  try_files {path} {path}/ /404.html
  file_server

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "geolocation=(), microphone=(), camera=()"
  }
}

api.aliperlaliberta.it {
  encode zstd gzip

  @portal_api path /api/portal/*
  reverse_proxy @portal_api apll-portal-api:8790

  @calendar_api path /api/calendar/* /health
  reverse_proxy @calendar_api 127.0.0.1:8787

  respond /status "online" 200

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
  }
}
